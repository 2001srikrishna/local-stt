# Copy to ~/.config/local-stt/stt.env. Literal assignments only; no shell expansion.
STT_THREADS=8
STT_LANGUAGE=en
STT_MAX_SECONDS=120
# Unset input device follows the desktop default through PipeWire, resolved on each press.
# STT_INPUT_DEVICE=pipewire
# STT_WHISPER_BIN=/absolute/path/to/whisper-cli
# STT_WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
# STT_LOG_TRANSCRIPTS=1
# Set GROQ_API_KEY privately in stt.env or the environment; never commit your key.
# Shared service sets STT_RESIDENT=1 (keep model loaded); standalone CLI defaults to 0.
# STT_SERVER_PORT=18765
# STT_WHISPER_SERVER=/absolute/path/to/whisper-server
# KDE desktop-wide hold/release shortcuts and guarded automatic insertion:
# STT_AUTO_PASTE=1
# STT_DESKTOP_BACKEND=auto
# STT_TRIGGER_MODE=hold
# STT_SYSTEM_PYTHON=/usr/bin/python3
